# ============================================================
# Blossom Baby — AI companion configuration
# ============================================================
# Copy this file to `.env` for local use:
#     cp .env.example .env
# OR set these as environment variables on your deploy platform
# (Render / Railway / Netlify / Fly.io — any Node host).
# Real environment variables always win over the .env file.

# --- REAL AI (the only required one) --------------------------
# Get a free key at https://aistudio.google.com → "Get API key".
# Without it the app runs in DEMO voice (cute canned replies).
GEMINI_API_KEY=

# --- Founder dashboard -----------------------------------------
# Protects /admin and /api/chat/stats. Open your deployed site at
# /admin and enter this token to see anonymous usage numbers.
CHAT_ADMIN_TOKEN=blossom-admin-2026

# --- Security (once public) ------------------------------------
# Comma-separated origins allowed to call /api/chat, e.g.
#   CHAT_CORS_ORIGINS=https://your-journal.netlify.app,http://localhost:4174
# Leave empty to allow any origin (fine for a private personal journal).
CHAT_CORS_ORIGINS=

# --- Daily caps (protect your key & budget) --------------------
CHAT_DAILY_DEVICE=20
CHAT_DAILY_IP=30
CHAT_DAILY_GLOBAL=1000

# --- Optional --------------------------------------------
# CHAT_ALLOW_MOCK=0      # turn off demo voice entirely
# GEMINI_MODEL=gemini-2.5-flash
